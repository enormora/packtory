{
    "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
    "testRunner": "mocha",
    "plugins": [
        "@stryker-mutator/mocha-runner",
        "./source/build-support/mutation-timeout/mutation-timeout-reporter.entry-point.ts"
    ],
    "coverageAnalysis": "perTest",
    "tempDirName": "target/.stryker-tmp",
    "allowConsoleColors": false,
    "concurrency": "100%",
    "timeoutMS": 5000,
    "timeoutFactor": 0,
    "dryRunTimeoutMinutes": 15,
    "incrementalFile": "target/stryker-incremental.json",
    "mochaOptions": {
        "config": "mocha.config.unit-tests.json",
        "ignore": ["source/build-support/canaries/**/*.test.ts"],
        "spec": [
            "source/bundle-emitter/publication-outcome.test.ts",
            "source/build-support/mutation-timeout/mutation-timeout-command-line-interface-runner.test.ts",
            "source/bootstrap-npm-package/bootstrap-runner.test.ts",
            "source/bundle-emitter/repository-coherence.test.ts",
            "source/bundle-emitter/emitter.test.ts",
            "source/packtory/packtory-package-tree.test.ts",
            "source/packtory/resolved-package.test.ts",
            "source/packtory/packtory.test.ts",
            "source/vendor-materializer/vendor-package-manifest.test.ts",
            "source/dead-code-eliminator/transform/named-declaration-kinds.test.ts",
            "source/dead-code-eliminator/evaluation/evaluation-context.test.ts",
            "source/dead-code-eliminator/reference-target.test.ts",
            "source/dead-code-eliminator/runtime-source-validity.test.ts",
            "source/dead-code-eliminator/transform/expression-read.test.ts",
            "source/dead-code-eliminator/liveness/runtime-code.test.ts",
            "source/dead-code-eliminator/evaluation/condition-outcome.test.ts",
            "source/dead-code-eliminator/evaluation/statement-evaluation.test.ts",
            "source/dead-code-eliminator/expression-facts.test.ts",
            "source/dead-code-eliminator/pure-expression.test.ts",
            "source/dead-code-eliminator/reachability/reachability.test.ts",
            "source/dependency-scanner/compiler-inputs.test.ts",
            "source/linker/replacement-lookup.test.ts",
            "source/linker/replacement-lookup-symbols.test.ts",
            "source/report/inspectors/inspect-workspace.test.ts",
            "source/configuration/**/*.test.ts",
            "source/command-line-interface/**/*.test.ts",
            "source/common/**/*.test.ts",
            "source/checks/**/*.test.ts",
            "source/bundle-emitter/registry/**/*.test.ts",
            "source/source-transformation/**/*.test.ts",
            "source/build-support/mutation-timeout/**/*.test.ts",
            "source/dead-code-eliminator/exports/namespace-demand.test.ts",
            "source/dead-code-eliminator/transform/**/*.test.ts",
            "source/dead-code-eliminator/!(eliminator*|dead-code-elimination*).test.ts",
            "source/dead-code-eliminator/*/**/*.test.ts",
            "source/!(dead-code-eliminator)/**/*.test.ts",
            "source/dead-code-eliminator/eliminator-reuse.test.ts",
            "source/**/*.test.ts"
        ]
    },
    "testRunnerNodeArgs": ["--experimental-strip-types", "--enable-source-maps"],
    "mutate": [
        "source/**/*.ts",
        "!source/**/*.test.ts",
        "!source/**/*.property.ts",
        "!source/**/*.type-test.ts",
        "!source/build-support/canaries/**/*.ts",
        "!source/test-libraries/**/*.ts",
        "!source/**/*.entry-point.ts",
        "!source/packages/**/*.composition.ts"
    ],
    "ignorePatterns": ["/target", "/integration-tests"],
    "disableTypeChecks": true,
    "thresholds": {
        "high": 100,
        "low": 100,
        "break": 100
    },
    "reporters": ["progress-append-only", "clear-text", "html", "json", "mutation-timeout"],
    "clearTextReporter": {
        "reportMutants": true,
        "reportScoreTable": false,
        "reportTests": false,
        "logTests": false,
        "skipFull": true
    },
    "htmlReporter": {
        "fileName": "target/stryker/index.html"
    },
    "jsonReporter": {
        "fileName": "target/stryker/mutation-report.json"
    }
}
