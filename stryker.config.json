{
    "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
    "testRunner": "mocha",
    "coverageAnalysis": "perTest",
    "tempDirName": "target/.stryker-tmp",
    "allowConsoleColors": false,
    "concurrency": "100%",
    "timeoutMS": 30000,
    "dryRunTimeoutMinutes": 15,
    "incrementalFile": "target/stryker-incremental.json",
    "mochaOptions": {
        "no-package": true,
        "no-opts": true,
        "no-config": true,
        "ui": "tdd",
        "extension": ["ts"],
        "ignore": ["source/build-support/canaries/**/*.test.ts"],
        "spec": [
            "source/dead-code-eliminator/reachability/identifier-target-collector.reexports.test.ts",
            "source/dependency-scanner/source-file-references.injected-imports*.test.ts",
            "source/report/terminal-renderer/terminal-preview-renderer-shared.test.ts",
            "source/dead-code-eliminator/exports/export-resolution.test.ts",
            "source/dead-code-eliminator/runtime-call-purity.test.ts",
            "source/dead-code-eliminator/transform/bundle-source-preparation.test.ts",
            "source/dead-code-eliminator/transform/runtime-source-preparation.test.ts",
            "source/dead-code-eliminator/transform/constant-control-flow.test.ts",
            "source/dead-code-eliminator/exports/namespace-demand-solver.test.ts",
            "source/source-transformation/text-edits.test.ts",
            "source/dead-code-eliminator/transform/unused-values.test.ts",
            "source/report/inspectors/inspect-workspace.test.ts",
            "source/**/*.test.ts"
        ]
    },
    "testRunnerNodeArgs": ["--experimental-strip-types", "--enable-source-maps"],
    "mutate": [
        "source/**/*.ts",
        "!source/**/*.test.ts",
        "!source/**/*.property.ts",
        "!source/**/*.type-test.ts",
        "!source/build-support/canaries/**/*.ts",
        "!source/test-libraries/**/*.ts",
        "!source/**/*.entry-point.ts",
        "!source/packages/**/*.composition.ts"
    ],
    "ignorePatterns": ["node_modules", "target", ".git", "integration-tests"],
    "disableTypeChecks": true,
    "thresholds": {
        "high": 100,
        "low": 100,
        "break": 100
    },
    "reporters": ["clear-text", "html", "json"],
    "clearTextReporter": {
        "reportMutants": true,
        "reportScoreTable": false,
        "reportTests": false,
        "logTests": false,
        "skipFull": true
    },
    "htmlReporter": {
        "fileName": "target/stryker/index.html"
    },
    "jsonReporter": {
        "fileName": "target/stryker/mutation-report.json"
    }
}
