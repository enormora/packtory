{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "../target/buildcache/unit-tests.tsbuildinfo",
        "rootDir": "..",
        "types": [
            "node",
            "mocha"
        ],
        "module": "Node18"
    },
    "references": [
        {
            "path": "./tsconfig.sources.json"
        }
