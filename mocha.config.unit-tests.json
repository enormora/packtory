{
    "diff": true,
    "forbid-pending": true,
    "extension": [
        "ts"
    ],
    "spec": [
        "./source/**/*.test.ts"
    ],
    "exclude": [],
    "jobs": 1,
    "parallel": true,
    "reporter": "dot",
    "slow": 75,
    "timeout": 10000,
    "ui": "tdd",
    "require": ["./source/test-libraries/test-lifecycle.ts"],
    "node-option": [
        "experimental-strip-types",
        "enable-source-maps"
    ]
}
