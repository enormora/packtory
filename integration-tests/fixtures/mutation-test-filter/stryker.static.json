{
    "mutate": ["integration-tests/fixtures/mutation-test-filter/static-value.ts"],
    "ignorePatterns": [
        "**",
        "!package.json",
        "!integration-tests/fixtures/mutation-test-filter/static-value.ts",
        "!integration-tests/fixtures/mutation-test-filter/static-forward.ts",
        "!integration-tests/fixtures/mutation-test-filter/static-cases.ts",
        "!integration-tests/fixtures/mutation-test-filter/unrelated-cases.ts",
        "!integration-tests/fixtures/mutation-test-filter/mocha.static.json"
    ],
    "plugins": ["@stryker-mutator/mocha-runner"],
    "testRunner": "mocha",
    "coverageAnalysis": "perTest",
    "mochaOptions": {
        "config": "integration-tests/fixtures/mutation-test-filter/mocha.static.json"
    },
    "testRunnerNodeArgs": ["--experimental-strip-types", "--enable-source-maps"],
    "concurrency": 1,
    "tempDirName": "target/.stryker-static-filter-fixture",
    "disableTypeChecks": true,
    "logLevel": "off",
    "reporters": [],
    "thresholds": { "high": 100, "low": 100, "break": 100 }
}
