{
    "mutate": [
        "integration-tests/fixtures/mutation-test-filter/literal-value.ts",
        "integration-tests/fixtures/mutation-test-filter/multiline-value.ts"
    ],
    "ignorePatterns": [
        "**",
        "!package.json",
        "!integration-tests/fixtures/mutation-test-filter/literal-value.ts",
        "!integration-tests/fixtures/mutation-test-filter/multiline-value.ts",
        "!integration-tests/fixtures/mutation-test-filter/filter-cases.ts"
    ],
    "plugins": [
        "@stryker-mutator/mocha-runner"
    ],
    "testRunner": "mocha",
    "coverageAnalysis": "perTest",
    "mochaOptions": {
        "spec": [
            "integration-tests/fixtures/mutation-test-filter/filter-cases.ts"
        ],
        "ui": "tdd"
    },
    "testRunnerNodeArgs": [
        "--experimental-strip-types",
        "--enable-source-maps"
    ],
    "concurrency": 1,
    "disableBail": true,
    "tempDirName": "target/.stryker-filter-fixture",
    "disableTypeChecks": true,
    "logLevel": "off",
    "reporters": [],
    "thresholds": {
        "high": 100,
        "low": 100,
        "break": 100
    }
}
